# Copy to .env for `supabase functions serve`, or set with `supabase secrets set`
# for the deployed function. Never commit the filled-in file.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Bare address on a domain verified in Resend. The display name is per app —
# "Thayi Setu", "ASHA Setu" or "Setu Care" — so it is not set here.
OTP_FROM_ADDRESS=no-reply@mysetu.live

# Optional. A full From header that overrides the per-app display name for
# every brand at once. Leave unset unless you need that.
# OTP_FROM=Setu <no-reply@mysetu.live>

# Optional. Where the OTP email looks for its logos. Defaults to this project's
# own public `brand` bucket, which core/upload_email_logos.sh fills.
# BRAND_ASSET_BASE=https://mysetu.live/brand
