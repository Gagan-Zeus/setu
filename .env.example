# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Every flutter command that should talk to Supabase reads it:
#
#   cd thayi && flutter run                --dart-define-from-file=../.env
#   cd asha  && flutter build apk --release --dart-define-from-file=../.env
#
# Leave it out and the app starts on mock data instead of half-connecting to
# a project that is not there.
#
# Both values below come from Supabase: Project Settings -> API keys.
#
# The publishable key is the one that is SAFE to ship - it ships inside every
# APK by design and is useless without a session, because Row Level Security
# decides what any signed-in user can read.
#
# The service_role / sb_secret_ key must never be put in this file. It bypasses
# RLS completely. It belongs only in Supabase's own secrets, where the Edge
# Functions read it, and in your shell when running core/upload_email_logos.sh.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to false to force all three apps onto mock data, e.g. a demo with no
# signal at all.
USE_SUPABASE=true
